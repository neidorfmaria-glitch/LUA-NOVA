import math

# Gravitational constant
G = 6.67430e-11

# Mass of the central body (kg)
M = 5.972e24

# Initial position (m)
x = 7.0e6
y = 0.0

# Initial velocity (m/s)
vx = 0.0
vy = 7.5e3

# Time step (s)
dt = 1.0

# Distance from the central body
r = math.sqrt(x**2 + y**2)

# Gravitational acceleration
ax = -G * M * x / r**3
ay = -G * M * y / r**3

# Euler method: update velocity
new_vx = vx + ax * dt
new_vy = vy + ay * dt

# Euler method: update position
new_x = x + new_vx * dt
new_y = y + new_vy * dt

# Display results
print("New position:")
print("x =", new_x)
print("y =", new_y)

print("\nNew velocity:")
print("vx =", new_vx)
print("vy =", new_vy)
for i in range(100):

    # calcula a distância
    r = math.sqrt(x**2 + y**2)

    # calcula a aceleração
    ax = -G * M * x / r**3
    ay = -G * M * y / r**3

    # atualiza a velocidade
    new_vx = vx + ax * dt
    new_vy = vy + ay * dt

    # atualiza a posição
    new_x = x + new_vx * dt
    new_y = y + new_vy * dt

    # substitui os valores antigos pelos novos
    x = new_x
    y = new_y
    vx = new_vx
    vy = new_vy

    print("Final position:")
print("x =", x)
print("y =", y)

print("\nFinal velocity:")
print("vx =", vx)
print("vy =", vy)
